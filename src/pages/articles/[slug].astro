---
import Base from '../../layouts/Base.astro';
import Arrow from '../../components/Arrow.astro';
import PostCard from '../../components/PostCard.astro';
import ContactBand from '../../components/ContactBand.astro';
import { render } from 'astro:content';
import { getPosts, formatDate, readingTime, typeLabel } from '../../lib/articles';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const all = await getPosts();
  return all.map((p) => ({ params: { slug: p.id }, props: { post: p, more: all.filter((x) => x.id !== p.id).slice(0, 3) } }));
}
const { post, more } = Astro.props;
const d = post.data;
const { Content } = await render(post);
const url = new URL(`/articles/${post.id}/`, site.url).toString();
const u = encodeURIComponent(url);
const t = encodeURIComponent(d.title);
const share = [
  { name: 'LinkedIn', href: `https://www.linkedin.com/sharing/share-offsite/?url=${u}`, path: 'M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9h4v12H3zM9 9h3.8v1.7h.1c.5-1 1.8-2 3.7-2 4 0 4.7 2.6 4.7 6V21h-4v-5.6c0-1.3 0-3-1.9-3s-2.1 1.4-2.1 2.9V21H9z' },
  { name: 'Facebook', href: `https://www.facebook.com/sharer/sharer.php?u=${u}`, path: 'M14 8h3V4h-3c-2.8 0-4.5 1.8-4.5 4.6V11H7v4h2.5v9h4v-9h3l.5-4h-3.5V8.8c0-.5.3-.8.5-.8z' },
  { name: 'X', href: `https://twitter.com/intent/tweet?url=${u}&text=${t}`, path: 'M17.8 3h3.1l-6.8 7.8 8 10.2h-6.3l-4.9-6.4L5.3 21H2.2l7.3-8.3L1.8 3h6.4l4.4 5.9zm-1.1 16.2h1.7L7.3 4.7H5.5z' },
  { name: 'WhatsApp', href: `https://wa.me/?text=${t}%20${u}`, path: 'M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .2-3.3-.7-2.8-1.1-4.6-4-4.7-4.2-.1-.2-1.1-1.5-1.1-2.9s.7-2 1-2.3c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 2c.1.2.1.4 0 .5l-.4.6-.4.4c-.1.2-.3.3-.1.6.2.3.8 1.4 1.8 2.2 1.2 1.1 2.2 1.4 2.5 1.6.3.1.5.1.7-.1l.9-1.1c.2-.3.4-.2.7-.1l1.9.9c.3.1.5.2.5.3.1.2.1.6-.1 1.1z' },
  { name: 'Email', href: `mailto:?subject=${t}&body=${u}`, path: 'M3 5h18v14H3zm1.8 1.5L12 12l7.2-5.5z' },
];
const image = d.cover ?? '/og.png';
const words = readingTime(post.body);
const isOrg = d.author === 'Transnetrix';
const face = isOrg ? '/favicon.svg' : '/images/founder.jpg';
const ld = {
  '@context': 'https://schema.org', '@type': d.type === 'news' ? 'NewsArticle' : 'Article',
  headline: d.title, description: d.summary, datePublished: d.date.toISOString(),
  author: { '@type': 'Person', name: d.author }, publisher: { '@type': 'Organization', name: site.name, url: site.url },
  image: new URL(image, site.url).toString(), mainEntityOfPage: url,
};
---
<Base title={d.title} description={d.summary} image={image} ogType="article" published={d.date} author={d.author}>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <article class="read">
    <header class="wrap read-head">
      <p class="crumbs"><a href="/">Home</a> / <a href="/articles/">Articles and News</a> / {typeLabel(d.type)}</p>
      <p class="label in" style="color:var(--red-text)">{typeLabel(d.type)}{d.tags.length > 0 && <span style="color:var(--grey)"> · {d.tags.join(' · ')}</span>}</p>
      <h1 class="display in d1">{d.title}</h1>
      <p class="lead in d2">{d.summary}</p>
      <div class="byline in d3">
        <img src={face} class={isOrg ? 'org' : undefined} alt="" width="48" height="48" />
        <div>
          <strong>{d.author}</strong>
          <span><time datetime={d.date.toISOString()}>{formatDate(d.date)}</time> · {words} min read</span>
        </div>
      </div>
    </header>

    {d.cover && <figure class="wrap read-cover"><img src={d.cover} alt={d.coverAlt ?? ''} /></figure>}

    <div class="wrap read-layout">
      <aside class="share" aria-label="Share this post">
        <span class="label-sm">Share</span>
        {share.map((s) => (
          <a href={s.href} target="_blank" rel="noopener" aria-label={`Share on ${s.name}`} title={s.name}>
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d={s.path} fill="currentColor" /></svg>
          </a>
        ))}
        <button type="button" data-copy={url} aria-label="Copy link" title="Copy link">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M10 14a5 5 0 0 0 7 0l3-3a5 5 0 0 0-7-7l-1 1" /><path d="M14 10a5 5 0 0 0-7 0l-3 3a5 5 0 0 0 7 7l1-1" /></svg>
        </button>
        <button type="button" data-native hidden aria-label="Share" title="Share">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 3v13M7 8l5-5 5 5M5 14v7h14v-7" /></svg>
        </button>
        <span class="copied" data-copied role="status"></span>
      </aside>

      <div class="prose">
        <Content />
        <div class="author-box">
          <img src={face} class={isOrg ? 'org' : undefined} alt="" loading="lazy" />
          <div>
            <p class="label-sm">{isOrg ? 'Published by' : 'Written by'}</p>
            <p><strong>{d.author}</strong></p>
            <p class="small muted">{isOrg ? 'Consultancy and solutions, Gilgit Baltistan. Marcom, EdTech, FinTech and IT Solutions, held together by an advisory core.' : 'Founder and Chief Executive, Transnetrix. Two decades in communication for development, programme delivery and institutional analytics.'}</p>
            <a class="link-arrow" href={isOrg ? '/about/' : '/about/#leadership'}>{isOrg ? 'About Transnetrix' : 'About the author'}<Arrow size={14} /></a>
          </div>
        </div>
      </div>
    </div>
  </article>

  {more.length > 0 && (
    <section class="wrap section">
      <div class="section-head"><div><p class="label">More from Articles and News</p><h2 class="h2">Keep reading.</h2></div><p><a href="/articles/">All posts</a></p></div>
      <div class="post-grid post-grid-3">{more.map((p) => <PostCard post={p} />)}</div>
    </section>
  )}

  <ContactBand />
</Base>

<script>
  const copy = document.querySelector<HTMLButtonElement>('[data-copy]');
  const note = document.querySelector<HTMLElement>('[data-copied]');
  copy?.addEventListener('click', async () => {
    try { await navigator.clipboard.writeText(copy.dataset.copy ?? location.href); if (note) note.textContent = 'Link copied'; }
    catch { if (note) note.textContent = 'Copy the address bar link'; }
    setTimeout(() => { if (note) note.textContent = ''; }, 2400);
  });
  const native = document.querySelector<HTMLButtonElement>('[data-native]');
  if (native && 'share' in navigator) {
    native.hidden = false;
    native.addEventListener('click', () => navigator.share({ title: document.title, url: location.href }).catch(() => {}));
  }
</script>
