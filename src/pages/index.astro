---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import ContactBand from '../components/ContactBand.astro';
import { getCollection } from 'astro:content';
import { partners, clientsA, clientsB } from '../data/company';
import PostCard from '../components/PostCard.astro';
import { getPosts } from '../lib/articles';

const practices = (await getCollection('practices')).sort((a, b) => a.data.order - b.data.order);
const latest = (await getPosts()).slice(0, 3);
const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
import { peaks } from '../data/peaks';
// Deterministic variety per line so every peak breathes at its own pace.
const r = (i: number, k: number) => ((Math.sin(i * 12.9898 + k * 78.233) * 43758.5453) % 1 + 1) % 1;
const lo = (i: number) => (0.35 + r(i, 1) * 0.4).toFixed(2);
const dur = (i: number) => (4.5 + r(i, 2) * 4).toFixed(2);
const delay = (i: number) => (r(i, 3) * 8).toFixed(2);
const cycle = ['var(--marcom)', 'var(--edtech)', 'var(--fintech)', 'var(--it)'];
const dbl = (a: string[]) => a.concat(a).map((t, i) => ({ t, hid: i >= a.length, c: cycle[i % 4] }));
const stats = [
  { n: 20, suf: '', label: 'Nearly twenty years of programme delivery and analytics' },
  { n: 11, suf: '', label: 'key engagements with donors, government and industry' },
  { n: 4, suf: '', label: 'practices under one accountable lead' },
  { n: 7, suf: '', label: 'international funders and agencies in the record' },
];
---
<Base>
  <section class="mhero" aria-labelledby="hero-title">
    <svg class="mhero-art" viewBox="0 0 1123 794" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
      <defs>
        <linearGradient id="rise" x1="0" y1="1" x2="0" y2="0"><stop offset="0" stop-color="#EC3013" stop-opacity="0.8" /><stop offset="1" stop-color="#EC3013" stop-opacity="0" /></linearGradient>
        <filter id="glow" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="3.2" /></filter>
      </defs>
      <image class="mhero-img" href="/images/hero-mountains.jpg" x="0" y="0" width="1123" height="794" preserveAspectRatio="xMidYMax slice" />
      <g class="sigs">
        {peaks.map(([x, y, h, dot], i) => (
          <g class={`sig ${dot === 2 ? 'hot' : ''}`} style={`--h:${h};--lo:${lo(i)};--t:${dur(i)}s;--d:-${delay(i)}s`}>
            <rect x={x} y={y} width={dot === 2 ? 1.6 : 1.2} height={h} fill="url(#rise)" />
            {dot === 2 && <circle class="halo" cx={x + 0.6} cy={y} r="5" fill="#EC3013" fill-opacity="0.55" filter="url(#glow)" />}
            {dot > 0 && <circle cx={x + 0.6} cy={y} r={dot === 2 ? 2.6 : 1.6} fill="#EC3013" fill-opacity={dot === 2 ? 0.95 : 0.6} />}
          </g>
        ))}
      </g>
    </svg>
    <div class="wrap mhero-copy">
      <p class="label in">Consultancy and solutions · Gilgit Baltistan</p>
      <h1 id="hero-title" class="display in d1">Programmes are designed in one place and lived in another. We work in that gap.</h1>
      <div class="words in d2" aria-hidden="true" data-words>
        <span>DESIGN</span><span>EVIDENCE</span><span>COMMUNICATE</span><span>DELIVER</span>
      </div>
      <div class="btn-row in d3">
        <a class="btn btn-primary" href="/contact/">Start a conversation<Arrow /></a>
        <a class="btn btn-outline" href="/practices/">Explore our practices<Arrow /></a>
      </div>
    </div>
  </section>

  <section class="wrap" aria-label="At a glance">
    <div class="stats-row reveal">
      {stats.map((s) => <div><p class="big" data-count={s.n}>{s.n}</p><p>{s.label}</p></div>)}
    </div>
  </section>

  <section class="wrap section" aria-labelledby="who-title">
    <div class="intro-split">
      <div>
        <p class="label"><span class="num">01</span>Who we are</p>
        <h2 id="who-title" class="h2" style="margin-top:18px">Rooted in Gilgit Baltistan. Working across Pakistan.</h2>
      </div>
      <div>
        <p class="lead" style="max-width:none">Transnetrix is a consultancy and solutions firm for public institutions, development partners and businesses. We design, evidence and communicate change, then deliver it through accountable technology and field partners.</p>
        <a class="link-arrow" href="/about/">More about us<Arrow size={14} /></a>
      </div>
    </div>
  </section>

  <section class="wrap section" aria-labelledby="offer-title">
    <div class="section-head">
      <div>
        <p class="label"><span class="num">02</span>Our offerings</p>
        <h2 id="offer-title" class="h2">Four practices and one advisory core.</h2>
      </div>
      <p>Choose a practice to see the services, how the work runs and the engagements behind it.</p>
    </div>
    <div class="offer-grid">
      {practices.map((p) => (
        <a class={`offer reveal t-${p.data.key}`} href={`/practices/${p.id}/`}>
          <div class="pic"><img src={p.data.image} alt={p.data.imageAlt} loading="lazy" /></div>
          <div class="body">
            <span class="label-sm text-c">{p.data.short}</span>
            <h3>{p.data.title}</h3>
            <p>{p.data.headline}</p>
            <span class="link-arrow text-c">Learn more<Arrow size={14} /></span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="wrap section" aria-labelledby="work-title">
    <div class="section-head">
      <div>
        <p class="label"><span class="num">03</span>Flagship engagements</p>
        <h2 id="work-title" class="h2">Evidence that institutions adopted.</h2>
      </div>
      <p class="small">Delivered by our founder in prior roles and presented as key personnel experience. <a href="/work/">All work</a></p>
    </div>
    <div class="proj-grid">
      {work.map((w) => (
        <a class={`proj reveal t-${w.data.key}`} href={`/work/${w.id}/`}>
          <img src={w.data.image} alt={w.data.imageAlt} loading="lazy" />
          <div class="body">
            <span class="label-sm" style="color:var(--grey-on-tint)">{w.data.client}</span>
            <h3>{w.data.title}</h3>
            <p class="small" style="color:var(--grey-on-tint)">{w.data.result}</p>
            <span class="link-arrow text-c" style="margin-top:auto">Read the case study<Arrow size={14} /></span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="wrap section" aria-labelledby="record-title">
    <div class="section-head">
      <div>
        <p class="label"><span class="num">04</span>Track record and partners</p>
        <h2 id="record-title" class="h2">Programmes delivered with</h2>
      </div>
      <p class="small">Technology partners: {partners.map((p) => p.name).join(' and ')}. <a href="/about/#partners">How we work together</a></p>
    </div>
    <div class="track" role="region" aria-label="Programmes delivered with">
      <div class="marquee">{dbl(clientsA).map((x) => <span aria-hidden={x.hid ? 'true' : undefined} style={`--c:${x.c}`}>{x.t}</span>)}</div>
      <div class="sep" aria-hidden="true"></div>
      <div class="marquee rev">{dbl(clientsB).map((x) => <span aria-hidden={x.hid ? 'true' : undefined} style={`--c:${x.c}`}>{x.t}</span>)}</div>
    </div>
  </section>

  {latest.length > 0 && (
    <section class="wrap section" aria-labelledby="news-title">
      <div class="section-head">
        <div>
          <p class="label"><span class="num">05</span>Articles and News</p>
          <h2 id="news-title" class="h2">Latest from Transnetrix.</h2>
        </div>
        <p>Writing on communication, evidence and delivery, and updates on our work. <a href="/articles/">All posts</a></p>
      </div>
      <div class="post-grid post-grid-3">{latest.map((p) => <PostCard post={p} />)}</div>
    </section>
  )}

  <section class="wrap section" aria-labelledby="legacy-title">
    <div class="heritage-band two reveal">
      <div class="her-pair">
        <figure><img src="/images/heritage/portrait.jpg" alt="Abdul Hameed Khawar" loading="lazy" /><figcaption><b>Abdul Hameed Khawar</b>Historian, 1913 to 1986</figcaption></figure>
        <figure><img src="/images/heritage/abdul-waheed.jpg" alt="Abdul Waheed" loading="lazy" /><figcaption><b>Abdul Waheed</b>Engineer, 1938 to 2024</figcaption></figure>
      </div>
      <div style="display:flex;flex-direction:column;gap:16px">
        <p class="label"><span class="num">{latest.length > 0 ? '06' : '05'}</span>Legacy</p>
        <h2 id="legacy-title" class="h2">A history kept by two generations.</h2>
        <p>Abdul Hameed Khawar spent his life writing down what Gilgit Baltistan had kept in memory: its peoples, their lineages and how the region's past fits together.</p>
        <p>His son Abdul Waheed (1938 to 2024), an engineer who retired as Executive Engineer from the Gilgit Baltistan Public Works Department, devoted himself to completing his father's work and brought about its posthumous publication.</p>
        <a class="btn btn-light" href="/legacy/">Read their story<Arrow /></a>
      </div>
    </div>
  </section>

  <ContactBand />
</Base>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const words = Array.from(document.querySelectorAll<HTMLElement>('[data-words] span'));
  const colors = ['#EC3013', '#0D7268', '#3B3A8F', '#9A5B12'];
  const textColors = ['#B82510', '#0A594F', '#2E2D6F', '#784710'];
  const setWord = (w: number) => words.forEach((el, i) => {
    el.style.color = i === w ? textColors[i] : '';
    el.style.borderBottomColor = i === w ? colors[i] : 'transparent';
  });
  setWord(0);
  if (!reduce) {
    let tick = 0;
    setInterval(() => setWord(++tick % 4), 2400);
  }
</script>
