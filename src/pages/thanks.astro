---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
---
<Base title="Thank you">
  <section class="wrap page-hero section-last">
    <div class="copy">
      <p class="label">Enquiry received</p>
      <h1 class="display">Thank you. Your message has reached us.</h1>
      <p class="lead">We will reply within two working days.</p>
      <div class="btn-row"><a class="btn btn-outline" href="/">Back to home<Arrow /></a></div>
    </div>
  </section>
</Base>
