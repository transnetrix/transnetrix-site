---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
---
<Base title="Page not found">
  <section class="wrap page-hero section-last">
    <div class="copy">
      <p class="label">404</p>
      <h1 class="display">This page has crossed a divide we can't follow.</h1>
      <p class="lead">The link may be old or mistyped.</p>
      <div class="btn-row"><a class="btn btn-primary" href="/">Go to the home page<Arrow /></a><a class="btn btn-outline" href="/contact/">Contact us</a></div>
    </div>
  </section>
</Base>
