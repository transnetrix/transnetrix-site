---
interface Props { href?: string; class?: string; label?: boolean }
const { href, class: cls = '', label = true } = Astro.props;
const Tag = href ? 'a' : 'span';
---
<Tag href={href} class={`wordmark ${cls}`} aria-label={label ? 'Transnetrix home' : undefined}>Trans<span class="seam" aria-hidden="true"></span>netrix</Tag>
