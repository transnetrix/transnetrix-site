---
// Social icons for the footer, using the platform logos in public/icons/.
// To change a logo, replace its PNG file there (round, transparent background).
// LinkedIn has no logo file yet, so it shows an outlined briefcase until one is added.
import { site } from '../data/site';
const files: Record<string, string> = {
  Facebook: '/icons/facebook.png',
  Instagram: '/icons/instagram.png',
  X: '/icons/x.png',
  YouTube: '/icons/youtube.png',
  TikTok: '/icons/tiktok.png',
  LinkedIn: '',
};
---
<ul class="socials">
  {site.social.map((s) => (
    <li>
      <a href={s.href} target="_blank" rel="noopener" aria-label={`Transnetrix on ${s.label}`} title={s.label}>
        {files[s.label]
          ? <img src={files[s.label]} alt="" width="40" height="40" loading="lazy" />
          : <span class="fallback" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 12h.01" /><path d="M16 6V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2" /><path d="M22 13a18.15 18.15 0 0 1-20 0" /><rect width="20" height="14" x="2" y="6" rx="2" /></svg></span>}
      </a>
    </li>
  ))}
</ul>
<style>
  .socials { display: flex; flex-wrap: wrap; gap: 12px; list-style: none; margin: 0; padding: 0; }
  .socials a { width: 44px; height: 44px; display: inline-flex; align-items: center; justify-content: center; border-radius: 50%; text-decoration: none; transition: transform .2s; }
  .socials a:hover, .socials a:focus-visible { transform: translateY(-3px); }
  .socials img { width: 40px; height: 40px; display: block; }
  .fallback { width: 40px; height: 40px; border-radius: 50%; border: 2px solid var(--ink); color: var(--ink); display: inline-flex; align-items: center; justify-content: center; }
</style>
